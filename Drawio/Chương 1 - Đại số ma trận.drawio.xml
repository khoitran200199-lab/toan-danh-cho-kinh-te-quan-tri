        <mxCell id="E2_EDGE_4" edge="1" parent="1" source="E2_HEADER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#1A237E;strokeWidth=1.5;curved=0;html=1;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" target="E2_CARD_4" value="">
