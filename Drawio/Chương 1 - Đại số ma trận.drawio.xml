        <mxCell id="E2_HEADER" parent="1" style="rounded=1;arcSize=10;fillColor=#1A237E;strokeColor=#0D47A1;fontColor=#ffffff;fontStyle=1;fontSize=13;shadow=1;fontFamily=Helvetica;html=1;whiteSpace=wrap;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="⚖️ [E2] ĐỊNH THỨC CỦA MA TRẬN VUÔNG&lt;br&gt;Chữ ký Số học, Thước đo Biến dạng Thể tích &amp;amp; Chẩn đoán Sức khỏe Hệ thống" vertex="1">
