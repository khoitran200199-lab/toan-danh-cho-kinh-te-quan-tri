        <mxCell id="E1_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#37474F;strokeColor=#212121;fontColor=#ffffff;fontStyle=1;fontSize=13;shadow=1;fontFamily=Helvetica;" value="🏛️ [E1] NGÂN HÀNG TRUNG ƯƠNG (NHNN)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 11px;&quot;&gt;Cơ quan Quản lý Tiền tệ &amp; Giám sát An toàn TCTD&lt;/span&gt;" vertex="1">
