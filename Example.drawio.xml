        <mxCell id="TITLE_TEXT" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#ffffff;fontSize=24;fontStyle=1;" value="CHƯƠNG 1: MÔ HÌNH HOẠT ĐỘNG KINH DOANH NGÂN HÀNG &amp; CÁC ĐỊNH CHẾ TÀI CHÍNH&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; opacity: 0.85; color: #94a3b8;&quot;&gt;Entity-based &amp; Hierarchical Systems Thinking Mindmap | Quản trị &amp; Chiến lược Ngân hàng UEH | Khung Basel III &amp; Luật Các TCTD 2024&lt;/span&gt;" vertex="1">
