        <mxCell id="E1_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#263238;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" value="1.1 🎯 VAI TRÒ &amp; BẢN CHẤT PHÁP LÝ:&lt;br/&gt;• Cơ quan ngang Bộ thuộc Chính phủ quản lý hệ thống TCTD&lt;br/&gt;• Phi thương mại, hoàn toàn không hoạt động vì lợi nhuận&lt;br/&gt;• Ổn định giá trị đồng tiền, kiểm soát lạm phát &amp; vĩ mô&lt;br/&gt;• Người cho vay cuối cùng (LoLR) cứu trợ thanh khoản" vertex="1">
          <mxGeometry height="80" width="330" x="2260" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="E1_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#263238;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" value="1.2 ⚙️ CÔNG CỤ &amp; CƠ CHẾ ĐIỀU TIẾT:&lt;br/&gt;• CSTT: Nghiệp vụ OMO, Tái cấp vốn, Dự trữ bắt buộc&lt;br/&gt;• Giám sát Basel: CAR ≥ 8%, siết trần LDR 85%, Room tín dụng&lt;br/&gt;• Luật TCTD 2024: Giảm trần sở hữu (Cá nhân 5%, Tổ chức 10%)&lt;br/&gt;• Bắt buộc dựng Firewalls ngăn sở hữu chéo &amp; lây lan (Đ.63, 136)" vertex="1">
          <mxGeometry height="90" width="350" x="2635" y="3490" as="geometry" />
        </mxCell>
        <mxCell id="E1_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#263238;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" value="1.3 ⚠️ CỨU TRỢ &amp; TÁC ĐỘNG HỆ THỐNG:&lt;br/&gt;• Định hình mặt bằng lãi suất &amp; chi phí vốn xã hội&lt;br/&gt;• Cho vay đặc biệt cứu thanh khoản khẩn cấp (Đ.192, 193)&lt;br/&gt;• Dập tắt nguy cơ sụp đổ thanh khoản dây chuyền&lt;br/&gt;• Giám sát chặt để triệt tiêu rủi ro đạo đức (Moral Hazard)" vertex="1">
