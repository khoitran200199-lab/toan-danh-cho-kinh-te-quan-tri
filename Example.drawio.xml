        <mxCell id="E4_HEADER" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1B5E20;strokeColor=#2E7D32;fontColor=#ffffff;fontStyle=1;fontSize=13;shadow=1;fontFamily=Helvetica;" value="💰 [E4] BÊN THỪA VỐN (SURPLUS UNITS)&lt;br/&gt;&lt;span style=&quot;opacity: 0.85; font-size: 11px;&quot;&gt;Hộ gia đình, Cá nhân gửi tiền &amp; Nhà đầu tư&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="340" x="1700" y="3715" as="geometry" />
        </mxCell>
        <mxCell id="E4_CARD_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" value="4.1 🎯 BẢN CHẤT &amp; ĐỘNG CƠ TÀI CHÍNH:&lt;br/&gt;• Cung ứng thặng dư tiết kiệm cho toàn nền kinh tế&lt;br/&gt;• Bảo toàn vốn gốc &amp; tối ưu hóa lãi suất sinh lời&lt;br/&gt;• Đòi hỏi tính thanh khoản cao (kỳ hạn ngắn, rút linh hoạt)&lt;br/&gt;• Ngại rủi ro (Risk-averse), yêu cầu cam kết trả 100% gốc" vertex="1">
          <mxGeometry height="80" width="320" x="1520" y="3815" as="geometry" />
        </mxCell>
        <mxCell id="E4_CARD_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" value="4.2 ⚙️ CÔNG CỤ &amp; KÊNH PHÂN BỔ VỐN:&lt;br/&gt;• Tiền gửi thanh toán không kỳ hạn (CASA giá rẻ)&lt;br/&gt;• Tiền gửi tiết kiệm kỳ hạn ngắn/dài, Chứng chỉ tiền gửi (CDs)&lt;br/&gt;• Kênh phi tiền gửi: Cổ phiếu, Trái phiếu DN, CCQ, Bảo hiểm&lt;br/&gt;• Gửi tiết kiệm online qua Ví điện tử (kết nối NHTM)" vertex="1">
          <mxGeometry height="80" width="330" x="1870" y="3815" as="geometry" />
        </mxCell>
        <mxCell id="E4_CARD_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;" value="4.3 ⚠️ HÀNH VI &amp; RỦI RO HỆ THỐNG:&lt;br/&gt;• Tâm lý bầy đàn kích hoạt tháo chạy tập thể (Bank Run)&lt;br/&gt;• Chấp nhận rủi ro mất vốn ở kênh phi tiền gửi (không BHTG)&lt;br/&gt;• Rủi ro lạm phát làm suy giảm lãi suất thực" vertex="1">
